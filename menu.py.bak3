#!/usr/bin/env python3
import os, sys, time, subprocess
from colorama import init, Fore, Style
init(autoreset=True)

sys.path.insert(0, os.path.expanduser("~/Omni/core"))
import recon, crawler, network, forensics, inject, export
from file_picker import pick_file

CONFIG_PATH = os.path.expanduser("~/.omni_config")
TOOL_NAME = "Ω-OMNI Core"

def load_config():
    global TOOL_NAME
    if os.path.exists(CONFIG_PATH):
        with open(CONFIG_PATH, 'r') as f:
            for line in f:
                if line.strip() and not line.startswith('#'):
                    key, val = line.strip().split('=', 1)
                    if key == "TOOL_NAME":
                        TOOL_NAME = val.strip()
    else:
        with open(CONFIG_PATH, 'w') as f:
            f.write("# Omni configuration\nTOOL_NAME=Ω-OMNI Core\n")

load_config()

def show_banner():
    banner = f"""
{Fore.CYAN}   ╔══════════════════════════════════════════════════════════╗
{Fore.CYAN}   ║                                                          ║
{Fore.MAGENTA}   ║        ██████  ███    ██ ███    ██ ██ ███████         ║
{Fore.MAGENTA}   ║       ██    ██ ████   ██ ████   ██ ██ ██              ║
{Fore.MAGENTA}   ║       ██    ██ ██ ██  ██ ██ ██  ██ ██ █████           ║
{Fore.MAGENTA}   ║       ██    ██ ██  ██ ██ ██  ██ ██ ██ ██              ║
{Fore.MAGENTA}   ║        ██████  ██   ████ ██   ████ ██ ███████         ║
{Fore.CYAN}   ║                                                          ║
{Fore.CYAN}   ╚══════════════════════════════════════════════════════════╝
{Style.RESET_ALL}
"""
    print(banner)
    print(f"{Fore.YELLOW}                ── {TOOL_NAME} ──{Style.RESET_ALL}\n")

last_result = None

def confirm_command(cmd):
    print(f"\n{Fore.YELLOW}[GENERATED] {cmd}{Style.RESET_ALL}")
    ans = input("[?] Execute? (y/n) > ").strip().lower()
    return ans in ['y', 'yes']

def run_submodule(module_func, *args):
    global last_result
    result = module_func(*args)
    last_result = result
    print(f"\n{Fore.GREEN}[RESULT]{Style.RESET_ALL}")
    print(result)
    input("\nPress Enter to continue...")
    return result

def recon_menu():
    while True:
        os.system('clear')
        show_banner()
        print("--- Reconnaissance ---")
        print("a. Subdomain brute‑force")
        print("b. Port scan")
        print("c. DNS lookup")
        print("d. WHOIS lookup")
        print("b. Back to main menu")
        choice = input("> ").strip().lower()
        if choice == "b":
            break
        elif choice == "a":
            domain = input("Domain (e.g., example.com): ").strip()
            if confirm_command(f"python3 ~/Omni/core/recon.py subdomains {domain}"):
                run_submodule(recon.subdomains, domain)
        elif choice == "b":
            target = input("Target IP/host: ").strip()
            ports = input("Port range (default 1-1024): ").strip() or "1-1024"
            if confirm_command(f"python3 ~/Omni/core/recon.py portscan {target} {ports}"):
                run_submodule(recon.port_scan, target, ports)
        elif choice == "c":
            domain = input("Domain: ").strip()
            if confirm_command(f"python3 ~/Omni/core/recon.py dns {domain}"):
                run_submodule(recon.dns_lookup, domain)
        elif choice == "d":
            domain = input("Domain: ").strip()
            print(recon.whois(domain))
            input("\nPress Enter to continue...")
        else:
            print("Invalid choice. Press Enter...")
            input()

def crawler_menu():
    while True:
        os.system('clear')
        show_banner()
        print("--- Web Crawler ---")
        print("a. Crawl a URL (extract links/emails)")
        print("b. Back to main menu")
        choice = input("> ").strip().lower()
        if choice == "b":
            break
        elif choice == "a":
            url = input("URL: ").strip()
            depth = input("Depth (default 1): ").strip() or "1"
            if confirm_command(f"python3 ~/Omni/core/crawler.py {url} --depth {depth}"):
                run_submodule(crawler.crawl, url, int(depth))
        else:
            print("Invalid choice. Press Enter...")
            input()

def network_menu():
    while True:
        os.system('clear')
        show_banner()
        print("--- Network Scanner ---")
        print("a. ARP sweep")
        print("b. Ping sweep (CIDR)")
        print("c. Show local listening ports")
        print("b. Back to main menu")
        choice = input("> ").strip().lower()
        if choice == "b":
            break
        elif choice == "a":
            iface = input("Interface (optional): ").strip() or None
            if confirm_command("arp-scan --localnet"):
                run_submodule(network.arp_scan, iface)
        elif choice == "b":
            cidr = input("CIDR (e.g., 192.168.1.0/24): ").strip()
            if confirm_command(f"python3 ~/Omni/core/network.py ping --cidr {cidr}"):
                run_submodule(network.ping_sweep, cidr)
        elif choice == "c":
            print(network.local_ports())
            input("\nPress Enter to continue...")
        else:
            print("Invalid choice. Press Enter...")
            input()

def forensics_menu():
    while True:
        os.system('clear')
        show_banner()
        print("--- Forensics & Injection ---")
        print("a. Hash file")
        print("b. Entropy analysis")
        print("c. EXIF read")
        print("d. EXIF write")
        print("e. Append payload to file")
        print("f. LSB steganography (hide message in image)")
        print("g. JPEG+ZIP polyglot")
        print("b. Back to main menu")
        choice = input("> ").strip().lower()
        if choice == "b":
            break
        elif choice == "a":
            path = pick_file()
            if path:
                algo = input("Hash algorithm (md5/sha1/sha256, default sha256): ").strip() or "sha256"
                if confirm_command(f"python3 ~/Omni/core/forensics.py hash {path} --algo {algo}"):
                    run_submodule(forensics.hash_file, path, algo)
        elif choice == "b":
            path = pick_file()
            if path:
                if confirm_command(f"python3 ~/Omni/core/forensics.py entropy {path}"):
                    run_submodule(forensics.entropy, path)
        elif choice == "c":
            path = pick_file()
            if path:
                print(forensics.exif_read(path))
                input("\nPress Enter to continue...")
        elif choice == "d":
            path = pick_file()
            if path:
                tag = input("EXIF tag (e.g., Artist, Comment): ").strip()
                value = input("Value to write: ").strip()
                out = pick_file() if input("Output file? (y/n): ").strip().lower() == 'y' else None
                if confirm_command(f"python3 ~/Omni/core/forensics.py exif_write {path} --tag {tag} --value '{value}' --output {out}"):
                    run_submodule(forensics.exif_write, path, tag, value, out)
        elif choice == "e":
            infile = pick_file()
            if infile:
                payload = input("Payload (text or path to file): ").strip()
                if os.path.isfile(payload):
                    with open(payload, "rb") as f:
                        payload_data = f.read()
        elif choice == "f":
            domain = input("Domain: ").strip()
            if confirm_command(f"python3 ~/Omni/core/ssl_scraper.py {domain}"):
                os.system(f"python3 ~/Omni/core/ssl_scraper.py {domain}")
        elif choice == "g":
            ip = input("IP address: ").strip()
            if confirm_command(f"python3 ~/Omni/core/reverse_dns.py {ip}"):
                os.system(f"python3 ~/Omni/core/reverse_dns.py {ip}")
        elif choice == "h":
            ip = input("IP address: ").strip()
            if confirm_command(f"python3 ~/Omni/core/asn_ip.py {ip}"):
                os.system(f"python3 ~/Omni/core/asn_ip.py {ip}")
        elif choice == "i":
            host = input("Host (IP/domain): ").strip()
            port = input("Port: ").strip()
            if confirm_command(f"python3 ~/Omni/core/banner_grab.py {host} {port}"):
                os.system(f"python3 ~/Omni/core/banner_grab.py {host} {port}")
        elif choice == "j":
            host = input("Host (domain): ").strip()
            port = input("Port (default 443): ").strip() or "443"
            if confirm_command(f"python3 ~/Omni/core/ssl_analysis.py {host} --port {port}"):
                os.system(f"python3 ~/Omni/core/ssl_analysis.py {host} --port {port}")
        elif choice == "k":
            print("Proxy/Tor Support")
            print("1. Set HTTP/HTTPS proxy")
            print("2. Unset proxy")
            print("3. Toggle Tor mode")
            sub = input("> ").strip()
            if sub == "1":
                http = input("HTTP proxy (e.g., http://127.0.0.1:8080): ").strip()
                https = input("HTTPS proxy: ").strip()
                os.system(f"python3 ~/Omni/core/proxy.py set --http {http} --https {https}")
            elif sub == "2":
                os.system("python3 ~/Omni/core/proxy.py unset")
            elif sub == "3":
                os.system("python3 ~/Omni/core/proxy.py tor")
            else:
                print("Invalid")
        elif choice == "l":
            print("Webhook Notifier")
            print("1. Configure webhook")
            print("2. Send message")
            sub = input("> ").strip()
            if sub == "1":
                service = input("Service (discord/telegram/slack): ").strip()
                url = input("Webhook URL: ").strip()
                os.system(f"python3 ~/Omni/core/webhook.py config --service {service} --url {url}")
            elif sub == "2":
                service = input("Service: ").strip()
                message = input("Message: ").strip()
                title = input("Title (optional): ").strip()
                os.system(f"python3 ~/Omni/core/webhook.py send --service {service} --message {message} --title {title}")
            else:
                print("Invalid")
        elif choice == "m":
            print("Task Scheduler")
            print("1. Add task")
            print("2. Start scheduler")
            print("3. List tasks")
            sub = input("> ").strip()
            if sub == "1":
                name = input("Task name: ").strip()
                cmd = input("Command to run (use absolute paths): ").strip()
                interval = input("Interval (number): ").strip()
                unit = input("Unit (minutes/hours/days): ").strip()
                os.system(f"python3 ~/Omni/core/scheduler.py add --name {name} --command {cmd} --interval {interval} --unit {unit}")
            elif sub == "2":
                os.system("python3 ~/Omni/core/scheduler.py start")
            elif sub == "3":
                os.system("python3 ~/Omni/core/scheduler.py list")
            else:
                print("Invalid")
        elif choice == "n":
            target_file = input("Target file path: ").strip()
            mod_cmd = input("Module command (use {target} placeholder): ").strip()
            threads = input("Threads (default 10): ").strip() or "10"
            os.system(f"python3 ~/Omni/core/mass_scan.py {target_file} --module {mod_cmd} --threads {threads}")
        elif choice == "o":
            print("Report Generator")
            inp = input("Input JSON file or last for last result: ").strip()
            out = input("Output HTML file (default report.html): ").strip() or "report.html"
            title = input("Report title (default Omni Report): ").strip() or "Omni Report"
            os.system(f"python3 ~/Omni/core/report_gen.py --input {inp} --output {out} --title {title}")
                else:
                    payload_data = payload.encode()
                outfile = pick_file() if input("Output file? (y/n): ").strip().lower() == 'y' else None
                if confirm_command(f"python3 ~/Omni/core/inject.py append {infile} --payload '{payload}' --output {outfile}"):
                    run_submodule(inject.append_payload, infile, payload_data, outfile)
        elif choice == "f":
            img = pick_file()
            if img:
                msg = input("Message to hide: ").strip()
                out = pick_file() if input("Output image? (y/n): ").strip().lower() == 'y' else None
                if confirm_command(f"python3 ~/Omni/core/inject.py lsb {img} --payload '{msg}' --output {out}"):
                    run_submodule(inject.lsb_hide, img, msg, out)
        elif choice == "g":
            jpg = pick_file()
            if jpg:
                zipf = pick_file()
                if zipf:
                    out = pick_file() if input("Output polyglot? (y/n): ").strip().lower() == 'y' else None
                    if confirm_command(f"python3 ~/Omni/core/inject.py polyglot {jpg} --payload {zipf} --output {out}"):
                        run_submodule(inject.polyglot_jpg_zip, jpg, zipf, out)
        else:
            print("Invalid choice. Press Enter...")
            input()

def export_menu():
    while True:
        os.system('clear')
        show_banner()
        print("--- Export ---")
        print("a. Export last result to JSON")
        print("b. Export last result to CSV")
        print("b. Back to main menu")
        choice = input("> ").strip().lower()
        if choice == "b":
            break
        if last_result is None:
            print("No result to export.")
            input("\nPress Enter to continue...")
            continue
        if choice == "a":
            filename = input("Output filename (optional): ").strip() or None
            f = export.export_json(last_result, filename)
            print(f"Exported to {f}")
            input("\nPress Enter to continue...")
        elif choice == "b":
            filename = input("Output filename (optional): ").strip() or None
            f = export.export_csv(last_result, filename)
            print(f"Exported to {f}")
            input("\nPress Enter to continue...")
        else:
            print("Invalid choice. Press Enter...")
            input()

