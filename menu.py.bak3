def main_menu():
    while True:
        os.system('clear')
        show_banner()
        print("1. Reconnaissance")
        print("2. Web Crawler")
        print("3. Network Scanner")
        print("4. File Forensics & Injection")
        print("5. Export Results")
        print("6. Advanced Tools")
        print("7. Exit")
        choice = input("> ").strip().lower()
        if choice in ["1", "recon"]:
            recon_menu()
        elif choice in ["2", "crawl"]:
            crawler_menu()
        elif choice in ["3", "network"]:
            network_menu()
        elif choice in ["4", "file", "forensics"]:
            forensics_menu()
        elif choice in ["5", "export"]:
            export_menu()
        elif choice in ["6", "advanced"]:
            advanced_menu()
        elif choice in ["7", "exit"]:
            print("Exiting.")
            break
        else:
            print("Invalid choice. Press Enter...")
            input()

if __name__ == "__main__":
    main_menu()
